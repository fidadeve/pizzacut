{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "root": ".",
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "installCommand": "npm run install -w client",
        "buildCommand": "npm run build -w client",
        "outputDirectory": "client/dist"
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/"
    }
  ]
}
